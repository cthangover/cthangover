<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="*.cs.txt" />
        <ProjectReference Include="Adapter/Adapter.csproj" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <Target Name="StageAdapter" AfterTargets="Build">
        <ItemGroup>
            <AdapterFile Include="Adapter/bin/$(Configuration)/$(TargetFramework)/*.dll" />
        </ItemGroup>
        <Copy SourceFiles="@(AdapterFile)" DestinationFolder="$(OutDir)adapter" />
    </Target>
</Project>
