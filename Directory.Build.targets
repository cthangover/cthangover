<Project>
    <!-- Keep the SDK's net10.0 compilation contract beside the core and in
         player exports: runtime mod compilation must not require an SDK. -->
    <Target Name="ShipModReferencePack"
            Condition="'$(MSBuildProjectName)' == 'Cthangover'"
            BeforeTargets="GetCopyToOutputDirectoryItems;GetCopyToPublishDirectoryItems"
            DependsOnTargets="ResolveFrameworkReferences">
        <ItemGroup>
            <_ModFramework Include="@(ResolvedFrameworkReference)" Condition="'%(Identity)' == 'Microsoft.NETCore.App'" />
        </ItemGroup>
        <PropertyGroup>
            <_ModReferenceRoot>@(_ModFramework->'%(TargetingPackPath)')</_ModReferenceRoot>
        </PropertyGroup>
        <ItemGroup>
            <_ModReference Include="$(_ModReferenceRoot)/ref/net10.0/*.dll" />
            <ContentWithTargetPath Include="@(_ModReference)"
                                   TargetPath="mod_reference_assemblies/net10.0/%(Filename)%(Extension)"
                                   CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
        </ItemGroup>
        <Error Condition="'@(_ModReference)' == ''" Text="The .NET 10 reference pack is required for runtime mod compilation." />
        <MakeDir Directories="$(IntermediateOutputPath)" />
        <WriteLinesToFile File="$(IntermediateOutputPath)mod-reference-pack.version"
                          Lines="@(_ModFramework->'%(TargetingPackVersion)')"
                          Overwrite="true" WriteOnlyWhenDifferent="true" />
        <ItemGroup>
            <ContentWithTargetPath Include="$(IntermediateOutputPath)mod-reference-pack.version"
                                   TargetPath="mod_reference_assemblies/net10.0/pack.version"
                                   CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
        </ItemGroup>
    </Target>

    <!-- Bind the SDK's reference assembly to the implementation produced by the
         same compile. A consumer can reject stale or partially copied contracts. -->
    <Target Name="ShipCoreModContract"
            Condition="'$(MSBuildProjectName)' == 'Cthangover' and '$(DesignTimeBuild)' != 'true' and '$(ProduceReferenceAssembly)' == 'true'
                       and Exists('@(IntermediateAssembly)') and Exists('@(IntermediateRefAssembly)')"
            BeforeTargets="GetCopyToOutputDirectoryItems;GetCopyToPublishDirectoryItems">
        <PropertyGroup>
            <_CoreModContractReceipt>$(IntermediateOutputPath)core-mod-contract.sha256</_CoreModContractReceipt>
        </PropertyGroup>
        <!-- Content collection precedes the SDK's normal copy to TargetRefPath.
             CopyRefAssembly keeps that file in place when its metadata is unchanged. -->
        <CopyRefAssembly SourcePath="@(IntermediateRefAssembly)" DestinationPath="$(TargetRefPath)" />
        <GetFileHash Files="@(IntermediateAssembly)" Algorithm="SHA256">
            <Output TaskParameter="Hash" PropertyName="_CoreImplementationHash" />
        </GetFileHash>
        <GetFileHash Files="@(IntermediateRefAssembly)" Algorithm="SHA256">
            <Output TaskParameter="Hash" PropertyName="_CoreReferenceHash" />
        </GetFileHash>
        <WriteLinesToFile File="$(_CoreModContractReceipt)"
                          Lines="$(_CoreImplementationHash);$(_CoreReferenceHash)"
                          Overwrite="true" WriteOnlyWhenDifferent="true" />
        <ItemGroup>
            <ContentWithTargetPath Include="$(TargetRefPath)"
                                   TargetPath="mod_reference_assemblies/core/Cthangover.dll"
                                   CopyToOutputDirectory="IfDifferent" CopyToPublishDirectory="IfDifferent"
                                   ExcludeFromSingleFile="true" />
            <ContentWithTargetPath Include="$(_CoreModContractReceipt)"
                                   TargetPath="mod_reference_assemblies/core/contract.sha256"
                                   CopyToOutputDirectory="IfDifferent" CopyToPublishDirectory="IfDifferent"
                                   ExcludeFromSingleFile="true" />
            <FileWrites Include="$(_CoreModContractReceipt)" />
        </ItemGroup>
    </Target>
</Project>
