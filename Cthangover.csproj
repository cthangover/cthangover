<Project Sdk="Godot.NET.Sdk/4.6.3">
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <RootNamespace>Cthangover</RootNamespace>
        <AssemblyName>Cthangover</AssemblyName>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
        <Nullable>disable</Nullable>
        <LangVersion>12</LangVersion>
        <SelfContained>true</SelfContained>
        <DefineConstants>$(DefineConstants);LOG_BATTLE_UI;LOG_SCENE_REGISTRY;LOG_MODS_COMPILE;LOG_MODS_REGISTRY;LOG_AI;LOG_AI_DEBUG;LOG_AUDIO;LOG_BATTLE;LOG_CACHE;LOG_CARD;LOG_CHAIN;LOG_COND;LOG_CONFIG;LOG_DIALOG;LOG_EVENT;LOG_GAME;LOG_GD_PLUGIN;LOG_ITEMS;LOG_LANG;LOG_LIGHT;LOG_QUEST;LOG_SAVE;LOG_SCENE;LOG_SCENE_REGISTRY;LOG_SERIALIZE;LOG_SHADER;LOG_STATUS;LOG_TEST;LOG_TOOLBOX;LOG_UI;LOG_VIEW;LOG_WIDGET</DefineConstants>
        <DefineConstants Condition="'$(OS)' == 'Windows_NT'">$(DefineConstants);WINDOWS</DefineConstants>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="3.11.0" />
        <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="3.11.0" />
        <PackageReference Include="System.Text.Json" Version="8.0.6" />
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="tests\Cthangover.Tests\**\*.cs" />
        <Compile Remove="tests\Cthangover.TestRunner\**\*.cs" />
        <Compile Remove="sdk\**\*.cs" />
        <Compile Include="mods\card_battle\src\ICard.cs" />

        <None Include="tests\Cthangover.Tests\**\*.cs" />
        <None Include="tests\Cthangover.TestRunner\**\*.cs" />
        <None Include="sdk\**\*.cs" />
        <Compile Remove="mods\**\*" />
        <None Include="mods\**\*" />
        <!-- The release packaging copies the whole mods/ tree next to the
             exported binaries; those loose copies must never re-enter the
             core compilation through the default source glob. -->
        <Compile Remove="releases\**\*" />
        <None Include="releases\**\*" />
    </ItemGroup>

    <ItemGroup>
        <Folder Include="Core\Scenes\Nodes" />
        <Folder Include="mods\cooking\src\items" />
    </ItemGroup>

    <!-- The runtime mod compiler hosts the Godot source generators
         (GodotGeneratorHost resolves them next to the game binary first),
         so the analyzer dll from the NuGet cache ships with the build and
         the exported game does not depend on the developer's NuGet cache. -->
    <Target Name="ShipGodotSourceGenerators" AfterTargets="Build">
        <ItemGroup>
            <GodotSourceGeneratorDll Include="$(NugetPackageRoot)godot.sourcegenerators\*\analyzers\dotnet\cs\Godot.SourceGenerators.dll" />
        </ItemGroup>
        <Copy SourceFiles="@(GodotSourceGeneratorDll)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    </Target>

    <!-- The export runs `dotnet publish`, whose output becomes the
         data_Cthangover_<platform> folder of the release. -->
    <Target Name="PublishGodotSourceGenerators" AfterTargets="Publish">
        <ItemGroup>
            <GodotSourceGeneratorDll Include="$(NugetPackageRoot)godot.sourcegenerators\*\analyzers\dotnet\cs\Godot.SourceGenerators.dll" />
        </ItemGroup>
        <Copy SourceFiles="@(GodotSourceGeneratorDll)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    </Target>

</Project>
