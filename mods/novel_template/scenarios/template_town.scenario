scene: template_town
priority: 10
---
# The town is the hub: every visit shows the same choice.
text "Вечерний город. Фонари уже горят, по мостовой тянет прохладой." key=template/town/intro
select "Куда пойти?" key=template/town/prompt
option "Зайти в бар" key=template/town/opt_bar -> :bar
option "Вернуться домой" key=template/town/opt_home -> :home

:bar
switch_scene template_bar
end

:home
switch_scene template_home
end
